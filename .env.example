# Database
POSTGRES_URI=postgresql+psycopg2://app:pass@db:5432/ssdr

# Redis
REDIS_URL=redis://redis:6379

# S3/MinIO Storage
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ssdr-evidences

# JWT Authentication
JWT_SECRET=change_me_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS Settings
ALLOWED_ORIGINS=http://localhost:5173,http://frontend:5173

# Data Directories
DATA_DIR=/data
INTAKES_DIR=/data/intakes
EXPORTS_DIR=/data/exports

# Email (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-password
SMTP_FROM=noreply@ssdr.dev

# Encryption
ENCRYPTION_KEY=base64:your-encryption-key-here
KMS_MASTER_KEY=base64:your-kms-key-here

# Development
DEBUG=false
LOG_LEVEL=INFO
# Frontend (Vite)
VITE_API_BASE=http://localhost:8000
